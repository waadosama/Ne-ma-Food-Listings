# Server
PORT=3001
NODE_ENV=development

# JSON Web Token settings.
# JWT_SECRET is the signing key for access tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit a real value. In development the server boots without it but
# generates an ephemeral secret, so every token is rejected on restart.
# Production refuses to start unless it is set and at least 32 characters.
JWT_SECRET=
# How long an access token stays valid. Accepts any value jsonwebtoken parses,
# e.g. 15m, 2h, 1d.
JWT_EXPIRES_IN=1d
# bcrypt cost factor. Each extra value doubles the work to verify a password:
# 10 is ~64 rounds of hashing, a reasonable default for a small service.
BCRYPT_ROUNDS=10

# The single administrator account, created by npm run db:reset.
#
# There is no self-service path to this role: registration only offers
# RESTAURANT and CHARITY. The admin is the only account that can verify
# organizations and read every tenant's listings, so its password is
# required to come from here rather than being committed.
#
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# In development a missing value seeds a well-known throwaway password and
# warns; production refuses to seed at all.
ADMIN_EMAIL=nema.admin@example.com
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Nema
ADMIN_LAST_NAME=Admin

# PostgreSQL connection string.
# Used by the app (src/config/database.js) and by db/setup.js.
# Example: postgres://user:password@localhost:5432/nema
DATABASE_URL=postgres://localhost:5432/nema
